# ---------- 必填 ----------
# PostgreSQL 连接串
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# 超级管理员账号(每次启动都会与数据库同步;改密码只需改这里并重启)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# 会话/令牌签名密钥,建议 32 位以上随机字符串
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- 服务 ----------
# 服务端口(next start 直接读取 PORT)
PORT=3000
# 对外访问地址,用于生成文件链接(留空则取请求头)。例: https://pics.example.com
PUBLIC_BASE_URL=
# 部署在 HTTPS 反代后建议开启,Cookie 加 Secure
COOKIE_SECURE=false
SESSION_DAYS=30

# ---------- 数据与性能 ----------
# 数据目录:原图(受管相册)、缩略图/预览图、品牌图标、临时文件
DATA_DIR=./data
# 缩略图/预览图/元数据处理的最大并发,防止批量导入时 CPU/内存被打满
THUMB_CONCURRENCY=15
THUMB_WIDTH=480
PREVIEW_WIDTH=1600
# 单文件上传上限(MB),0 = 不限
MAX_UPLOAD_MB=0

# ---------- 挂载目录(VPS 多目录场景) ----------
# 允许挂载/导入的根目录白名单,逗号分隔;留空 = 不限制(仅管理员可操作)
ALLOWED_MOUNT_ROOTS=
# 自动重扫挂载相册的间隔(分钟),0 = 关闭
SCAN_INTERVAL_MIN=0

# ---------- 视频(可选) ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- 对象存储 S3(可选,配置 S3_BUCKET 即启用) ----------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
