# ---------- 必填 ----------
# 数据库驱动:postgres | sqlite
#   postgres —— 需要 DATABASE_URL(适合正式部署,支持多实例)
#   sqlite   —— 使用 Node 内置 SQLite(node:sqlite),单文件、零外部服务,
#               适合手机本地测试 / 图片数量不多的个人图库
# 不设置时:有 DATABASE_URL 就用 postgres,否则自动回落到 sqlite
DB_DRIVER=postgres
# SQLite 数据文件(DB_DRIVER=sqlite 时生效),默认 DATA_DIR/pgs.sqlite
SQLITE_FILE=
# PostgreSQL 连接串(DB_DRIVER=postgres 时必填)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# 超级管理员账号(每次启动都会与数据库同步;改密码只需改这里并重启)
ADMIN_USER=admin
# 管理员密码:生产环境(NODE_ENV=production)下若仍是占位值会【拒绝启动】
ADMIN_PASSWORD=change-this-password
# 会话/令牌签名密钥,建议 32 位以上随机字符串。
# 留空时:生产环境会自动生成随机密钥并持久化到 DATA_DIR/secret.key(权限 0600),用户不配也安全。
SESSION_SECRET=

# ---------- 时区 ----------
# 站点默认时区(IANA 名称)。通知发布时间、日期分组都按它换算;
# 部署后仍可在「设置 → 系统状态 → 时区」里修改,历史通知的显示时间会同步变化。
TZ=Asia/Shanghai

# ---------- 服务 ----------
# 服务端口(next start 直接读取 PORT)
PORT=3000
# 对外访问地址,用于生成文件链接(留空则取请求头)。例: https://pics.example.com
PUBLIC_BASE_URL=
# 允许用于生成链接/水印的 Host 白名单,逗号分隔;留空 = 只信任请求自身的 Host / PUBLIC_BASE_URL
ALLOWED_HOSTS=
# 提示:HD 游客水印成品缓存(同一张图第二次打开几乎零成本)要求「请求域名可信」——设置 PUBLIC_BASE_URL,或让请求域名命中 ALLOWED_HOSTS;
#       两者都不设时水印文字里的域名无法确定可信,程序会照常出图但不缓存(响应头 x-pgs-wm-cache: untrusted-host)。
# 信任几层反向代理:0 = 只信反代「覆盖写入」的 X-Real-IP(推荐);1 = 取 X-Forwarded-For 倒数第 1 段
TRUST_PROXY=0
# 部署在 HTTPS 反代后建议开启,Cookie 加 Secure
COOKIE_SECURE=false
SESSION_DAYS=30

# ---------- 数据与性能 ----------
# 数据目录:原图(受管相册)、缩略图/预览图、品牌图标、临时文件
DATA_DIR=./data
# 图片(缩略图/预览图/元数据)处理并发;留空 = 默认 min(4, CPU 核数)
# docker compose 部署同样读取这里(旧名 PGS_THUMB_CONCURRENCY 仍兼容)
THUMB_CONCURRENCY=
# 视频(ffprobe/ffmpeg)与 HEIC 解码单独限流,避免与图片抢内存
VIDEO_CONCURRENCY=2
HEIC_CONCURRENCY=1
# 媒体内存治理(缩略图/预览图/HD 水印共用一个内存预算,按「像素 × 格式」估算每个任务的内存)
# 内存预算 MB:留空 = 按容器内存自动推导((上限×0.85−250MB)×0.7,夹在 256~2048);0 = 关闭预算,只按并发数
MEDIA_BUDGET_MB=
# 单任务估算内存硬限制 MB:超过直接拒绝(状态 failed,错误以 [LIMIT] 开头,不会被「疑似损坏文件」自动清理删除原图);留空 = 预算×1.5
MEDIA_MAX_EST_MB=
# 派生图输入像素上限(百万像素),超过的文件以 [LIMIT] 拒绝;低配机器建议 100
MEDIA_MAX_INPUT_MP=268
# libvips 每个任务内部线程数(1C1G 建议 1)
SHARP_CONCURRENCY=2
# 动态内存压力保护:水位(cgroup 工作集/上限)过高时自动降低/暂停新任务准入
MEDIA_PRESSURE_GUARD=true
THUMB_WIDTH=720
PREVIEW_WIDTH=1600
# EXIF 只读文件头字节数(读不到再自动放大到 8MB;TIFF 会一直放大到整文件,上限 EXIF_MAX_BYTES=64MB)
EXIF_READ_BYTES=1048576
# 单文件上传上限(MB),默认 2048;0 = 不限
MAX_UPLOAD_MB=2048
# 上传前要求的最小剩余磁盘(MB),低于此值直接拒绝上传;0 = 不检查
MIN_FREE_DISK_MB=1024
# 疑似损坏文件(处理失败)的自动清理:停止上传满该小时数后自动删除;0 = 关闭
CORRUPT_AUTO_PURGE_HOURS=5
# JSON 请求体上限(KB)
JSON_BODY_MAX_KB=1024

# ---------- 数据库连接池 ----------
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=20000
DB_CONNECT_TIMEOUT_MS=5000
# 连接云数据库(需要 TLS)时设为 true
DATABASE_SSL=false

# ---------- 挂载目录(VPS 多目录场景) ----------
# 允许挂载/导入的根目录白名单,逗号分隔。
# 留空时只允许:数据目录、/photos、/mnt、/media、/srv、/home、/volume1(及其子目录)。
ALLOWED_MOUNT_ROOTS=
# 自动重扫挂载相册的间隔(分钟),0 = 关闭
SCAN_INTERVAL_MIN=0
# 递归扫描最大目录深度(含根为 0),超过的子目录不再下探并在扫描结果里提示
SCAN_MAX_DEPTH=32
# 扫描熔断:一次扫描允许清理的最大"消失文件"比例,超过则中止清理并报错
SCAN_PRUNE_MAX_RATIO=0.3
# 已知记录数低于此值时不做比例熔断(小相册正常删文件)
SCAN_PRUNE_MIN_COUNT=20

# ---------- 隐私与限流 ----------
# 游客可见的元数据级别:full(全部) | basic(去掉 GPS/序列号/作者邮箱/原始段) | none
GUEST_META=basic
# 是否允许游客看到管理员备注(默认关闭;备注也不参与公开搜索)
GUEST_NOTE=false
# 匿名搜索限流(每 IP 每分钟)
SEARCH_RATE_PER_MIN=60
# 无效下载密钥校验限流(每 IP 每分钟)
KEY_RATE_PER_MIN=30

# ---------- 视频(可选) ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- 对象存储 S3(可选,配置 S3_BUCKET 即启用) ----------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# ---------- 高清预览(HD):按需生成、临时缓存、短期令牌、服务端水印、独立限流 ----------
# 高清图最大宽度 / 最大高度 / WebP 质量(输出一律不含元数据)
HD_WIDTH=2560
HD_MAX_HEIGHT=4096
HD_QUALITY=82
# 同时进行的高清转换数、单张原图最大输入像素(百万像素)
HD_CONCURRENCY=3
HD_MAX_INPUT_MP=200
# 临时磁盘缓存:目录(默认 DATA_DIR/cache/hd,不会被任何静态 URL 暴露)、容量上限 MB(LRU)、有效期(天)
HD_CACHE_DIR=
HD_CACHE_MAX_MB=2048
HD_CACHE_TTL_DAYS=7
# 高清访问令牌有效期(秒)
HD_TOKEN_TTL_SEC=90
# 独立限流(每分钟):每 IP / 每用户 / 每张图片 / 每 IP 申请令牌
HD_RATE_IP_PER_MIN=30
HD_RATE_USER_PER_MIN=40
HD_RATE_MEDIA_PER_MIN=120
HD_RATE_TOKEN_PER_MIN=60
# 异常批量访问检测:窗口(秒)内访问的不同图片超过此数 → 封禁该 IP HD_SCAN_BLOCK_SEC 秒
HD_SCAN_DISTINCT=150
HD_SCAN_WINDOW_SEC=300
HD_SCAN_BLOCK_SEC=300
# 服务端水印:文字模板(宏 {host}=站点域名、{project}=github 项目地址)、透明度%(默认 8,越大越明显)、字号、角度、密度(1~5)
HD_WM_ENABLED=true
HD_WM_TEXT=Source: {host} · {project}
HD_WM_OPACITY=8
HD_WM_FONT_SIZE=16
HD_WM_ANGLE=-30
HD_WM_DENSITY=3
# 登录用户叠加动态标识水印(U-XXXXXX,不可逆,不含 IP/用户名)
HD_WM_USER=true
# 中文水印需指定 CJK 字体文件(默认使用依赖自带的 DejaVu Sans,仅含拉丁字符)
HD_WM_FONT_FILE=

# ---------- docker compose 专用(仅 docker-compose.yml 读取) ----------
# 镜像标签:固定版本号,升级时手动改这里
PGS_TAG=1.4.4
# 数据库驱动:postgres(默认) | sqlite(SQLite 单文件,无需 db 服务)
PGS_DB_DRIVER=postgres
# SQLite 数据文件路径(容器内),DB_DRIVER=sqlite 时生效
PGS_SQLITE_FILE=/app/data/pgs.sqlite
# 数据库密码(必填)
PGS_DB_PASSWORD=
# 管理员账号密码与签名密钥(必填)
PGS_ADMIN_USER=admin
PGS_ADMIN_PASSWORD=
PGS_SESSION_SECRET=
# 容器内 Node 堆上限(MB),应与 compose 的 mem_limit 匹配
PGS_NODE_HEAP_MB=1024
# libuv 线程池大小(镜像默认 12;1C1G 小机器建议 4)。compose 已映射,取消注释即可
# UV_THREADPOOL_SIZE=12
